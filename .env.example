# Supabase Configuration
# Get these values from your Supabase project settings at https://supabase.com
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# App Configuration
# Set to true to skip authentication (development only)
EXPO_PUBLIC_SKIP_AUTH=false

# Deep Link URL for password recovery and other redirects
# Local development: exp://127.0.0.1:8081
# Production: your-app-url.com
EXPO_PUBLIC_APP_URL=exp://127.0.0.1:8081

# Backend API URL (used by src/api/api.js for login, cadastro, etc.)
# Production (Render): already works from any phone/network.
# IMPORTANT: "localhost" ONLY works in an emulator/simulator — on a physical
# phone it points to the phone itself, not your computer. If you need to run
# the backend locally (cd backend && npm run dev), replace this with your
# machine's LAN IP (e.g. http://192.168.x.x:3000) and keep the phone on the
# same Wi-Fi network.
EXPO_PUBLIC_API_URL=https://motus-dm29.onrender.com
