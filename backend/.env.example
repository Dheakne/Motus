# ─── SUPABASE ────────────────────────────────────────
# Settings → API (ou Project Settings → Data API / API Keys)
SUPABASE_URL=https://your-project.supabase.co
# SECRETA: dá acesso total ao banco. Nunca commitar, nunca usar no app ou no painel.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here
# Nome do bucket de áudio no Storage
SUPABASE_STORAGE_BUCKET=audio

# ─── SERVIDOR ────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────
# App mobile: '*' em desenvolvimento
FRONTEND_URL=*
# Painel admin: origens separadas por vírgula. Nunca '*'
ADMIN_FRONTEND_URL=http://localhost:5173
